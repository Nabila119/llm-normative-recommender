?formula: implication

?implication: disjunction
            | disjunction "->" implication   -> implication

?disjunction: conjunction
            | conjunction "∨" disjunction    -> disjunction

?conjunction: negation
            | negation "∧" conjunction       -> conjunction

?negation: primary
         | "¬" negation                      -> negation

?primary: modal_formula
        | quantifier
        | predicate
        | "(" formula ")"

modal_formula: MODAL_OP "(" formula ")"
             | MODAL_OP "(" formula "|" formula ")"

quantifier: "∀" NAME "." formula
          | "∃" NAME "." formula

predicate: NAME "(" term_list ")"
         | NAME

term_list: term
         | term "," term_list

?term: NAME "(" term_list ")"          -> function_term
     | NAME                            -> atomic_term

NAME: /[a-zA-Z][a-zA-Z0-9_]*/

MODAL_OP.2: "O" | "P" | "F"

%import common.WS
%ignore WS
